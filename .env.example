# LiteLLM Proxy Configuration
LITELLM_API_BASE=http://localhost:4000
LITELLM_API_KEY=sk-your-api-key-here

# Optional: Override the default LLM model
# LITELLM_MODEL=ollama/qwen2.5:7b-instruct-q4_k_m

# LiteLLM Master Key (for running the proxy)
LITELLM_MASTER_KEY=sk-your-master-key-here

# Optional: Override the embedding model (default: all-MiniLM-L6-v2)
# Other options: all-mpnet-base-v2, paraphrase-MiniLM-L6-v2, etc.
# See: https://www.sbert.net/docs/pretrained_models.html
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional: LLM Retry Configuration
# LLM_MAX_RETRIES=3        # How many times to retry on failure (default: 3)
# LLM_RETRY_MIN_WAIT=1     # Minimum wait between retries in seconds (default: 1)
# LLM_RETRY_MAX_WAIT=10    # Maximum wait between retries in seconds (default: 10)

# Optional: Cache Configuration
# CACHE_TTL_DAYS=7         # How many days to keep cached PDFs (default: 7)
